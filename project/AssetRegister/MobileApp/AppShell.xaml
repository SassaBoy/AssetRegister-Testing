<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:MobileApp.Views"
       x:Class="MobileApp.AppShell"
       Title="Asset Register"
       Shell.BackgroundColor="{StaticResource Navy}"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Shell.NavBarHasShadow="False">

    <!-- Home is the first screen. The other screens are opened on top of it. -->
    <ShellContent Title="Home" ContentTemplate="{DataTemplate views:HomePage}" Route="HomePage" />

</Shell>
