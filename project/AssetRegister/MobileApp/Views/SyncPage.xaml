<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileApp.Views.SyncPage"
             Title="Sync">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Padding="20,20,20,0">

        <!-- Summary -->
        <VerticalStackLayout Grid.Row="0" Spacing="12">
            <Label Text="{Binding LastSyncText}" StyleClass="Caption" FontSize="13" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" StyleClass="Card" BackgroundColor="{StaticResource WarningSoft}" Stroke="{StaticResource WarningSoft}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding PendingCount}" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource Warning}" />
                        <Label Text="Waiting to sync" FontSize="13" TextColor="{StaticResource Warning}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" StyleClass="Card" BackgroundColor="{StaticResource SuccessSoft}" Stroke="{StaticResource SuccessSoft}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding SyncedCount}" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource Success}" />
                        <Label Text="Synced" FontSize="13" TextColor="{StaticResource Success}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>

        <!-- Status / error message -->
        <Border Grid.Row="1" StyleClass="Card">
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding Message}" Value="">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Border.Triggers>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <ActivityIndicator Grid.Column="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding Message}" FontAttributes="Bold" VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Assets on this phone -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding NewAssets}">
            <CollectionView.Header>
                <Label Text="Assets registered on this phone" StyleClass="H2" Margin="0,4,0,10" />
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Border StyleClass="Card" Margin="0,4,0,0">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Padding="0,16">
                        <Label Text="Nothing to sync" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="New assets you register will appear here." StyleClass="Caption" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StyleClass="Card" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="3">
                                <Label Text="{Binding Description}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding Barcode, StringFormat='Barcode: {0}'}" StyleClass="Caption" />
                                <Label Text="{Binding StatusText}" StyleClass="Caption" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1" VerticalOptions="Start" StrokeThickness="0" Padding="10,4"
                                    StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource WarningSoft}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Synced}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SuccessSoft}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Pending" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Warning}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Synced}" Value="True">
                                            <Setter Property="Text" Value="Synced" />
                                            <Setter Property="TextColor" Value="{StaticResource Success}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Sync Now -->
        <VerticalStackLayout Grid.Row="3" Spacing="0" Margin="-20,0,-20,0" BackgroundColor="{StaticResource Surface}">
            <BoxView HeightRequest="1" Color="{StaticResource Line}" />
            <Button Text="Sync now" Command="{Binding SyncNowCommand}" Margin="20,12,20,16">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="IsEnabled" Value="False" />
                        <Setter Property="Text" Value="Syncing..." />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
