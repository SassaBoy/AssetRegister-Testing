<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileApp.Views.ScanAssetPage"
             Title="Scan asset">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Button Text="Scan barcode" Clicked="OnScanClicked" />
            <Button Text="Type code" Clicked="OnTypeCodeClicked" />

            <Label Text="{Binding Message}" FontSize="16" />

            <VerticalStackLayout IsVisible="{Binding HasResult}" Spacing="6">
                <Label Text="{Binding AssetId, StringFormat='Asset ID: {0}'}" />
                <Label Text="{Binding Description, StringFormat='Description: {0}'}" />
                <Label Text="{Binding AssetClass, StringFormat='Class: {0}'}" />
                <Label Text="{Binding Custodian, StringFormat='Custodian: {0}'}" />
                <Label Text="{Binding SerialNumber, StringFormat='Serial number: {0}'}" />
            </VerticalStackLayout>

            <Button Text="Register as new asset" Command="{Binding RegisterAsNewCommand}" IsVisible="{Binding CanRegister}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
