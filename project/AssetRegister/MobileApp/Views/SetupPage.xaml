<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileApp.Views.SetupPage"
             Title="Setup">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="Service address" />
            <Entry Text="{Binding ServiceAddress}" Placeholder="http://192.168.1.10:5080" Keyboard="Url" />

            <Label Text="Access key" />
            <Entry Text="{Binding AccessKey}" IsPassword="True" />

            <Label Text="Your name" />
            <Entry Text="{Binding UserName}" />

            <HorizontalStackLayout Spacing="10">
                <Switch IsToggled="{Binding UseFakeService}" />
                <Label Text="Use fake service (for testing without GP)" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button Text="Test connection" Command="{Binding TestConnectionCommand}" />
            <Label Text="{Binding TestResult}" FontAttributes="Bold" />

            <Button Text="Save" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
