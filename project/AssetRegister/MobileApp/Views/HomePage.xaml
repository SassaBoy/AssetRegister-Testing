<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MobileApp.Views.HomePage"
             Title="Asset Register">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Setup" Command="{Binding OpenSetupCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,28" Spacing="16">

            <!-- Status banner -->
            <Border BackgroundColor="{StaticResource Navy}" StrokeThickness="0" Padding="20" StrokeShape="RoundRectangle 20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="SYNC STATUS" FontSize="12" FontAttributes="Bold" TextColor="#9DB2D4" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <BoxView Grid.Column="0" WidthRequest="12" HeightRequest="12" CornerRadius="6"
                                 Color="{StaticResource Amber}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding WaitingText}" FontSize="20" FontAttributes="Bold" TextColor="White" />
                    </Grid>
                    <Label Text="Assets you register are stored safely on this phone until they are synced."
                           FontSize="13" TextColor="#9DB2D4" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Quick actions" StyleClass="H2" Margin="0,4,0,0" />

            <Button Text="Scan asset" Command="{Binding ScanAssetCommand}" HeightRequest="60" FontSize="18" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="New asset" StyleClass="Secondary" Command="{Binding NewAssetCommand}" />
                <Button Grid.Column="1" Text="Sync" StyleClass="Secondary" Command="{Binding OpenSyncCommand}" />
            </Grid>

            <Border StyleClass="Card" BackgroundColor="{StaticResource AccentSoft}" Stroke="{StaticResource AccentSoft}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Works offline" FontAttributes="Bold" TextColor="{StaticResource Navy}" />
                    <Label Text="Scan or register assets without a connection. Sync runs when the app opens, or any time from the Sync screen."
                           FontSize="13" TextColor="{StaticResource TextMuted}" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
